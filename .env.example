# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables.

# Supabase project URL and anon (public) key — safe to expose in the browser.
# Find these in Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — SERVER-SIDE ONLY. Never expose this to the browser,
# never prefix it with NEXT_PUBLIC_. It bypasses all Row Level Security.
# Find it in Supabase: Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
